{
  "name": "my-cv-typescript",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "npx kill-port 5173 60354 60355",
    "dev": "concurrently -n FE,BE -c cyan,green \"npm run dev:fe\" \"npm run dev:be\"",
    "dev:fe": "vite",
    "dev:be": "cd ../backend && dotnet run --project src/Backend.csproj",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.30",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^10.0.3",
    "happy-dom": "^20.10.1",
    "typescript": "^5.0.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
